<?xml version="1.0"?>
<robot name="ieg55" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ieg55" params="parent prefix *origin">
        <joint name="${prefix}mount" type="fixed">
            <insert_block name="origin"/>
            <parent link="${parent}"/>
            <child link="${prefix}base"/>
        </joint>
        <link name="${prefix}base">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.27"/>
                <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="package://weiss_gripper_ieg76/meshes/ieg55.stl"/>
                </geometry>
                <material name="black">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>
        </link>

        <joint name="${prefix}center" type="fixed">
            <parent link="${parent}"/>
            <child link="${prefix}center"/>
            <origin rpy="0 0 0" xyz="0 0 0.045"/>
        </joint>
        <link name="${prefix}center"/>

    </xacro:macro>
</robot>
